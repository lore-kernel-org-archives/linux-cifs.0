+		scnprintf(name, namesize, ".__smbfile_silly%0*x",
+			  (int)sizeof(cifs_sillycounter) * 2,
 			  atomic_inc_return(&cifs_sillycounter));
 		sdentry = lookup_noperm(&QSTR(name), dentry->d_parent);
 		if (IS_ERR(sdentry))
